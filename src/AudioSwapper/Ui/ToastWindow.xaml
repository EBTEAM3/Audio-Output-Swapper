<Window x:Class="AudioSwapper.Ui.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        SizeToContent="Height"
        Width="392" MinHeight="120"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
      Drawn natively rather than in WebView2. The toast is the one surface that
      appears on every switch, and hosting it in a browser meant booting a
      Chromium stack (7 processes, ~500MB) just to draw a rounded box with two
      lines of text in it. Native also buys real per-pixel window transparency,
      so the corners can be a proper 22px with a soft shadow instead of the 8px
      DWM compromise a WebView2 window is stuck with.

      The 22px margin on the root grid is shadow room — the window has to be
      bigger than the panel for the drop shadow to have somewhere to fall.
    -->
    <Grid Margin="22">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="PanelScale" ScaleX="0.94" ScaleY="0.94" />
                <TranslateTransform x:Name="PanelSlide" X="30" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Border x:Name="Panel"
                CornerRadius="22"
                BorderThickness="1"
                MouseLeftButtonUp="OnPanelClicked">
            <Border.Effect>
                <!-- the float. Big, soft, offset down. -->
                <DropShadowEffect x:Name="PanelShadow"
                                  BlurRadius="46" ShadowDepth="13" Direction="270"
                                  Opacity="0.55" Color="#000000" />
            </Border.Effect>

            <Grid>
                <!-- the 1px inset top highlight. Cheapest "this is glass"
                     cue there is; a panel without it reads as a hole. -->
                <Border x:Name="TopHighlight"
                        CornerRadius="22,22,0,0"
                        BorderThickness="0,1,0,0"
                        VerticalAlignment="Top"
                        Height="22" />

                <Grid Margin="16,14,16,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--
                      Both rows are Auto. With a starred first row the text
                      block gets whatever height is left over, so any content
                      taller than the window (a third line, a larger system font
                      scale) is silently squeezed under the progress bar instead
                      of pushing the window taller.
                    -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- The one filled-accent element; it carries the switch. -->
                    <Border x:Name="Badge"
                            Grid.Column="0" Grid.Row="0"
                            Width="46" Height="46"
                            CornerRadius="23"
                            VerticalAlignment="Center"
                            Margin="0,0,13,0">
                        <Canvas Width="24" Height="24"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="IconPath"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Canvas>
                    </Border>

                    <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                            <!-- micro-label — small, uppercase, wide-tracked. -->
                            <TextBlock x:Name="Kicker"
                                       Text="SWITCHED TO"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Border x:Name="CommsChip"
                                    CornerRadius="999"
                                    Padding="8,2"
                                    Margin="7,0,0,0"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="CommsChipText"
                                           Text="+ CALLS"
                                           FontSize="10"
                                           FontWeight="Bold" />
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="DeviceName"
                                   Text="&#8212;"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0" />

                        <!-- The 2px below is descender room: without it the
                             tails of g, y and p sit right on the progress bar. -->
                        <TextBlock x:Name="DeviceSub"
                                   FontSize="11.5"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,2" />
                    </StackPanel>

                    <!-- track recessed, fill raised, both fully rounded.
                         A clock rather than a user-triggered transition, so the
                         fill animates linearly. -->
                    <Border x:Name="CountdownTrack"
                            Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                            Height="3"
                            CornerRadius="999"
                            Margin="0,13,0,0"
                            ClipToBounds="True">
                        <Rectangle x:Name="CountdownFill"
                                   RadiusX="1.5" RadiusY="1.5"
                                   HorizontalAlignment="Stretch"
                                   RenderTransformOrigin="0,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="CountdownScale" ScaleX="1" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
